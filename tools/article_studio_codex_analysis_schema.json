{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "category", "page_role", "follow_url", "follow_reason", "analysis_summary", "adult_content", "adult_reason", "main_subject", "official_work", "social_profiles", "identified_people", "media_person_attributions", "person_identity_candidates", "fanza_relevance", "fanza_performer_name", "fanza_search_query", "fanza_product_code", "fanza_reason", "fanza_people", "fanza_image_products", "fanza_recommendation_queries", "image_decisions", "video_decisions"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "enum": ["SNS", "画像", "動画", "話題"]
    },
    "page_role": {
      "type": "string",
      "enum": ["article", "gateway", "index", "unclear"]
    },
    "follow_url": {
      "type": "string",
      "maxLength": 2048
    },
    "follow_reason": {
      "type": "string",
      "maxLength": 300
    },
    "analysis_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "adult_content": {
      "type": "boolean"
    },
    "adult_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "main_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "role", "is_public_creator", "reason"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": ["person", "group", "work", "product", "topic", "unknown"]
        },
        "role": {
          "type": "string",
          "maxLength": 80
        },
        "is_public_creator": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "official_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "title", "url", "provider", "reason", "thumbnail_url"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "ambiguous", "not_found", "not_applicable"]
        },
        "title": {
          "type": "string",
          "maxLength": 180
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        },
        "provider": {
          "type": "string",
          "maxLength": 80
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        },
        "thumbnail_url": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "social_profiles": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "service", "url", "is_main_subject", "reason", "thumbnail_url"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "service": {
            "type": "string",
            "enum": ["x", "tiktok", "instagram", "youtube", "myfans", "fantia"]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "is_main_subject": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "thumbnail_url": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "identified_people": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "is_public_creator", "confidence", "evidence_types", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "role": {
            "type": "string",
            "maxLength": 80
          },
          "is_public_creator": {
            "type": "boolean"
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "evidence_types": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "enum": ["headline", "caption", "alt", "link_text", "official_profile", "official_page", "product_credit", "source_metadata"]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "media_person_attributions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["person_name", "image_ids", "video_ids", "confidence", "evidence_types", "reason"],
        "properties": {
          "person_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "image_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "video_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "evidence_types": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "enum": ["headline", "caption", "alt", "link_text", "official_profile", "official_page", "product_credit", "source_metadata"]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "person_identity_candidates": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_type", "media_id", "candidates", "unresolved_reason"],
        "properties": {
          "media_type": {
            "type": "string",
            "enum": ["image", "video"]
          },
          "media_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "role", "confidence", "evidence_types", "evidence_urls", "reason"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "role": {
                  "type": "string",
                  "maxLength": 80
                },
                "confidence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 94
                },
                "evidence_types": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": ["headline", "caption", "alt", "link_text", "source_metadata", "watermark_ocr", "filename_clue", "web_search_result", "reverse_image_result", "video_frame_match"]
                  }
                },
                "evidence_urls": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          },
          "unresolved_reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "fanza_relevance": {
      "type": "string",
      "enum": ["none", "related", "likely_product", "exact_product"]
    },
    "fanza_performer_name": {
      "type": "string",
      "maxLength": 80
    },
    "fanza_search_query": {
      "type": "string",
      "maxLength": 120
    },
    "fanza_product_code": {
      "type": "string",
      "maxLength": 40
    },
    "fanza_reason": {
      "type": "string",
      "maxLength": 240
    },
    "fanza_people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image_ids", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "image_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "fanza_image_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_title", "product_code", "product_url", "image_ids", "video_ids", "reason"],
        "properties": {
          "product_title": {
            "type": "string",
            "maxLength": 180
          },
          "product_code": {
            "type": "string",
            "maxLength": 40
          },
          "product_url": {
            "type": "string",
            "maxLength": 2048
          },
          "image_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "video_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "fanza_recommendation_queries": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    },
    "image_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "verdict", "role", "recommended_use", "content_group", "relation", "visible_creator_handle", "subject_match", "relevance_score", "reason"],
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "verdict": {
            "type": "string",
            "enum": ["article", "advertisement", "logo", "navigation", "unrelated", "unclear"]
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "recommended_use": {
            "type": "string",
            "enum": ["thumbnail", "body", "thumbnail_and_body", "exclude"]
          },
          "content_group": {
            "type": "string",
            "maxLength": 80
          },
          "relation": {
            "type": "string",
            "maxLength": 160
          },
          "visible_creator_handle": {
            "type": "string",
            "maxLength": 80
          },
          "subject_match": {
            "type": "string",
            "enum": ["matched", "mismatch", "unknown"]
          },
          "relevance_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "video_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "verdict", "visible_creator_handle", "subject_match", "relevance_score", "reason"],
        "properties": {
          "video_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "verdict": {
            "type": "string",
            "enum": ["article", "advertisement", "navigation", "unrelated", "unclear"]
          },
          "visible_creator_handle": {
            "type": "string",
            "maxLength": 80
          },
          "subject_match": {
            "type": "string",
            "enum": ["matched", "mismatch", "unknown"]
          },
          "relevance_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  }
}
