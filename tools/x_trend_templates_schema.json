{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["observations", "templates"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "finding", "confidence"],
        "properties": {
          "label": {"type": "string", "minLength": 2, "maxLength": 30},
          "finding": {"type": "string", "minLength": 8, "maxLength": 180},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "name",
          "media_kinds",
          "hook_style",
          "body_style",
          "ending_style",
          "tone",
          "length_target",
          "avoid"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{3,32}$"
          },
          "name": {"type": "string", "minLength": 2, "maxLength": 30},
          "media_kinds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"type": "string", "enum": ["video", "images", "none"]}
          },
          "hook_style": {"type": "string", "minLength": 6, "maxLength": 120},
          "body_style": {"type": "string", "minLength": 6, "maxLength": 160},
          "ending_style": {"type": "string", "minLength": 4, "maxLength": 100},
          "tone": {"type": "string", "minLength": 2, "maxLength": 60},
          "length_target": {"type": "integer", "minimum": 25, "maximum": 180},
          "avoid": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "minLength": 2, "maxLength": 60}
          }
        }
      }
    }
  }
}
